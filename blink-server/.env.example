# Copy this file to .env and fill in what you have.

PORT=3000
CORS_ORIGIN=*

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/blink

# Required for POST/PUT/DELETE /api/courses and POST /api/sync.
ADMIN_API_KEY=change-me-to-something-random

# Used to sign user login tokens (separate secret from ADMIN_API_KEY).
JWT_SECRET=change-me-to-something-else-random

# --- Free Chatbot AI APIs (Choose ANY one or leave blank for local catalog engine) ---
# Option 1: Google Gemini (100% FREE API key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Option 2: Groq (Fast & Free API key at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option 3: OpenRouter (Free models at https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-lite-preview-02-05:free

# Option 4: Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Google Sign-In (Optional Client ID from Google Cloud Console) ---
GOOGLE_CLIENT_ID=

# Set to a number > 0 to auto-sync in the background every N minutes.
SYNC_INTERVAL_MINUTES=0

# --- Coursera (Public catalog API, no key needed) ---

# --- edX (Optional) ---
EDX_CLIENT_ID=
EDX_CLIENT_SECRET=
EDX_TOKEN_URL=https://api.edx.org/oauth2/v1/access_token
EDX_CATALOG_BASE_URL=https://api.edx.org/catalog/v1

# --- Udemy (Optional) ---
UDEMY_CLIENT_ID=
UDEMY_CLIENT_SECRET=
