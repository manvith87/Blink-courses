{
  "name": "blink-courses",
  "version": "2.0.0",
  "private": true,
  "description": "Blink: Full-stack Free Course Directory backed by MongoDB",
  "main": "api/index.js",
  "scripts": {
    "build": "npm run build --prefix blink-frontend",
    "start": "node blink-server/server.js",
    "dev:frontend": "npm run dev --prefix blink-frontend",
    "dev:server": "npm start --prefix blink-server",
